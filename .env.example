# Copy the values you need into your host's environment settings.
PORT=8123
HOST=0.0.0.0
# Where the SQLite database is stored. Point this at a persistent volume in production.
DATA_DIR=./data
NODE_ENV=production
# Set to 1 when running behind a reverse proxy / platform load balancer.
TRUST_PROXY=1
SECURE_COOKIES=0
SESSION_DAYS=30
LOG_REQUESTS=1
# Online rooms are topped up with bots to this many fighters (0 = real players only).
ROOM_FIGHTERS=8
# Sites allowed to call the API cross-origin (the CrazyGames build). Comma-separated.
CORS_ORIGINS=https://*.crazygames.com
# Optional: pin CrazyGames' token-signing public key instead of fetching it.
# CRAZYGAMES_PUBLIC_KEY_URL=https://sdk.crazygames.com/publicKey.json
